# Copy this file to config.env and edit values.
# Do not commit config.env with real passwords.

DOMAIN="example.ru"
MAIL_HOST="mail.example.ru"
SERVER_IP="203.0.113.10"

# Old IMAP server used by imapsync.
OLD_IMAP_HOST="imap.old-provider.example"
OLD_IMAP_PORT="993"
OLD_IMAP_SSL="yes"

# New local IMAP target.
NEW_IMAP_HOST="127.0.0.1"
NEW_IMAP_PORT="143"

# Paths.
VMAIL_BASE="/var/vmail"
POSTFIX_VDOMAINS="/etc/postfix/vdomains"
POSTFIX_VMAILBOX="/etc/postfix/vmailbox"
DOVECOT_USERS="/etc/dovecot/users"
MAILBOXES_CSV="/root/mail-migration/mailboxes.csv"
LOGDIR="/root/mail-migration/logs"

# Webmail.
ROUNDCUBE_DIR="/var/www/roundcube"
ROUNDCUBE_VERSION="1.6.11"
APACHE_USER="bitrix"
APACHE_GROUP="bitrix"

# BitrixVM / nginx reverse proxy.
# If Apache vhost listens on another port, change it.
APACHE_BACKEND="127.0.0.1:8887"

# DKIM selector.
DKIM_SELECTOR="mail"

# Set to yes only after reviewing scripts.
CONFIRM_PRODUCTION="no"
